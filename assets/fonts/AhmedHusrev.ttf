tAdContainer.style.display = 'none';
}, QUICK_BANNER.time.auto_close * 1000);
setTimeout(function () {
tAdContainer.style.display = 'block';
}, (QUICK_BANNER.time.again_show * 1000) + (QUICK_BANNER.time.wait * 1000));
});
