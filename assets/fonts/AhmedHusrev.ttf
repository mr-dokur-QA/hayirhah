}
});
var pageıd = 73;
$("#popup-login").find('#popup-member-login').wrap("<div class='col col-8 p-left popup-uyeGiris p-left'></div>");
$('#popup-login').find('#popup-member-login').attr('class', 'btn col-12 btn-success text-upper text-center login');
$("#popup-login").find('.popup-uyeGiris').after('<a href="/uye-kayit" class="btn col col-4 btn-custom-gray text-upper text-center" id="member-register">Üye Ol</a>');
$("#popup-login").find('#member-register').after("<div class='box col-12 popup-sifreHatirlartma'></div>");
$('#popup-member-forgot-password').appendTo('.popup-sifreHatirlartma ');
$('#popup-login').find('.box.col-sm-12.p-bottom').addClass('social-alan');
$('#popup-login').find('.col.col-md-12.p-left').addClass('social-alan-tab');
$('.social-alan:last-child').after('<div class="box col-12 line-top text-right title"><a href="http://temsilci.hayrat.com:8021/temsilcisiparis/Giris.aspx">Temsilci</a> | <a href="http://bayi.hayrat.com:8023/siparislerim/Giris.aspx">Bayi</a></div>');
$('.login-top').click(function () {
$('#popup-login').fadeToggle(0);
});
$('.login-top-1 #popup-login > .popupInnerBlock').after('<div class="pos-f pos-top pos-right pos-bottom pos-left overlay1"></div>');
$('.login-top').click(function () {
$(this).addClass('overlay-wrap1');
});
$('.overlay1').click(function () {
$('.login-top').trigger('click');
});
$('.fav-alan a').click(function(e){
e.preventDefault();
$(".login-top").trigger("click");
});
if (/Android|webOS|iPhone|iPad|iPod|BlackBerry/i.test(navigator.userAgent)) {
if ($(window).width() < 769) {
$('#search').appendTo('#mobileSearch');
}
if (/webOS|iPhone|iPad|iPod/i.test(navigator.userAgent)) {
$('option[disabled]').remove();
}
$('.parentLink > a, .parent > a').click(function (e) {
e.preventDefault();
$(this).next('ul').slideToggle();
});
var currentPage = location.pathname;
$('#slideMenu a[href="' + currentPage + '"]').parent().addClass('current');
} else {
if (navigator.appVersion.indexOf('Trident') > -1 && navigator.appVersion.indexOf('Edge') == -1) {
$('.withPlace').removeClass('withPlace');
}
}
flexPlace();
if (/^.*?[\?\&]q=/ig.test(window.location.href)) {
var sWord = window.location.href.replace(/^.*?[\?\&]q=/ig, '');
sWord = sWord.replace(/\&.*?$/ig, '').replace(/\+/ig, ' ');
$('#live-search').val(decodeURIComponent(sWord));
}
var mobileAppCookie = getaCookie('MobileNotifyClose');
if (mobileAppCookie == null && !isSafari) {
$('.MobileAppNotify').fadeIn();
}
$('.MobileNotifyClose').click(function () {
setaCookie('MobileNotifyClose', 'Closed', 3);
$('.MobileAppNotify').fadeOut();
});
$('#FormAra').click(function () {
if (!$(this).hasClass('focus')) {
$(this).addClass('focus');
$(this).find('input[type="text"]').focus();
}
});
$('body').click(function (e) {
var elem = e.target.id;
if ($('#' + elem).parents('#search').length < 1) {
$('#FormAra').removeClass('focus');
$('#FormAra input[type="text"]').val('');
$('#live-search-box').empty().fadeOut();
}
});
$('body').keydown(function (e) {
if (e.keyCode == 27) {
$('#FormAra').removeClass('focus');
$('#FormAra input[type="text"]').val('');
$('#live-search-box').empty().fadeOut();
}
});
$('.language li').click(function () {
setLanguage($(this).attr('data-value'));
});
$('.currency li').click(function () {
setCurrency($(this).attr('data-value'));
});
$('.whatsp').click(function () {
$('.whtspPopup').css("display", "block");
});
$('.close-popup').click(function () {
$('.whtspPopup').css("display", "none");
});
/*
var pageıd = { $PAGE_ID };
if (pageıd == 2) {
$('#leftColumn').addClass('listeSayfasi');
$('#mainColumn').addClass('col-9');
}
*/
});
$('.lcItem.lang .lcItems').click(function () {
/*setLanguage($(this).attr("data-value"));*/
var _lang = $(this).data('value');
var _curr = (_lang == 'tr') ? 'TL' : 'USD';
$.ajax({
url: '/srv/service/language/change/' + _lang + '/' + $('#link_type').val() + '/' + $('#link_table_id').val(),
dataType: 'json',
success: function (msg) {
$.post("/srv/shopping/shopping/set-currency/" + _curr, {}, function (r) {
if (msg.link.length > 1) {
var add = window.location.search || '';
window.location.href = '/' + msg.link + add;
} else {
window.location.reload();
}
});
}
});
});
function scrollShowCallback() {
if (!$('#headerMain').hasClass('stickyY')) {
$('#headerMain').addClass('stickyY');
}
}
function scrollHideCallback() {
if ($('#headerMain').hasClass('stickyY')) {
$('#headerMain').removeClass('stickyY');
}
}
function setaCookie(cname, cvalue, exdays) {
var d = new Date();
d.setTime(d.getTime() + (exdays * 24 * 60 * 60 * 1000));
var expires = "expires=" + d.toUTCString();
document.cookie = cname + "=" + cvalue + "; " + expires;
}
function getaCookie(name) {
var dc = document.cookie;
var prefix = name + "=";
var begin = dc.indexOf("; " + prefix);
if (begin == -1) {
begin = dc.indexOf(prefix);
if (begin != 0)
return null;
} else {
begin += 2;
var end = document.cookie.indexOf(";", begin);
if (end == -1) {
end = dc.length;
}
}
return unescape(dc.substring(begin + prefix.length, end));
}
function setCountry(country) {
var europeCountries = [
'DE', 'AL', 'BE', 'FR', 'NL', 'IE', 'CH',
'LI', 'LU', 'MC', 'BY', 'BG', 'CZ', 'HU',
'MD', 'PL', 'RO', 'SK', 'UA', 'DK', 'EE',
'FI', 'SE', 'IS', 'LT', 'NO', 'BA', 'HR',
'ES', 'IT', 'ME', 'MK', 'MT', 'PT', 'RS',
'SI', 'GR', 'AZ', 'AM', 'GE', 'KZ', 'CY',
'RU', 'GI', 'FO'
];
$.get('/srv/shopping/shopping/set-country/' + country, function (r) {
var curr = 'USD';
if (country == 'TR') {
curr = 'TL';
}
else if ($.inArray(country, europeCountries) >= 0) {
curr = 'USD';
}
else {
curr = 'USD';
}
$.post("/srv/shopping/shopping/set-currency/" + curr, {}, function (r) {
window.location.reload();
});
console.log(country);
});
}
</script>
